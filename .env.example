# =============================================================================
# ERP AI Platform - Environment Variables Template
# Copy this file to .env and customize for your environment
# Or use environment-specific files: .env.development, .env.testing, etc.
# =============================================================================
#
# QUICK START:
#   1. Copy this file: cp .env.example .env
#   2. Edit .env with your values
#   3. Run: docker compose up
#
# ENVIRONMENT-SPECIFIC FILES:
#   .env.development  - Local development (default)
#   .env.testing      - Automated testing / CI
#   .env.staging      - Pre-production staging
#   .env.production   - Production deployment
#
# Docker Compose automatically loads .env from the project root.
# To use an environment-specific file:
#   docker compose --env-file .env.development up
#
# SECURITY:
#   - NEVER commit .env or .env.* files to version control
#   - Use strong, unique passwords in production
#   - Rotate credentials regularly
#   - Consider using a secrets manager (HashiCorp Vault, AWS Secrets Manager, etc.)
# =============================================================================

# -------------------- Application --------------------
# Application name used in Docker labels and logging
APP_NAME=erp-ai-platform

# Application version (semantic versioning)
APP_VERSION=0.1.0-SNAPSHOT

# Active Spring profile (local, dev, test, staging, prod)
SPRING_PROFILES_ACTIVE=local

# Application server port
SERVER_PORT=8080

# -------------------- Container Registry --------------------
# Container image registry hostname
REGISTRY=registry.example.com

# Registry namespace/organization
REGISTRY_NAMESPACE=erpai

# -------------------- Build Configuration --------------------
# Additional Docker build arguments (space-separated)
BUILD_ARGS=

# Push built images to registry (true/false)
PUSH=false

# Build cache source (for docker buildx)
CACHE_FROM=

# Build cache destination (for docker buildx)
CACHE_TO=

# Scan images for vulnerabilities (true/false)
SCAN=false

# -------------------- JVM Configuration --------------------
# Additional JVM options (e.g., -Xmx2g -XX:+UseG1GC)
JAVA_OPTS=

# Java version for build (used in Docker ARG)
JAVA_VERSION=21

# Build date (ISO 8601 format, set by CI/CD)
BUILD_DATE=unknown

# Version control reference (commit SHA, set by CI/CD)
VCS_REF=unknown

# Path to application JAR (used in Docker COPY)
JAR_PATH=build/libs/*.jar

# Service name for microservice builds
SERVICE_NAME=erp-ai-platform

# Gradle module path for service (e.g., business:finance:interfaces)
SERVICE_MODULE=platform:interfaces

# -------------------- Resource Limits --------------------
# Default memory limit for containers
MEMORY_LIMIT=1G

# Default memory request for containers
MEMORY_REQUEST=512M

# Default CPU limit for containers (millicores or fraction)
CPU_LIMIT=1000m

# Default CPU request for containers (millicores or fraction)
CPU_REQUEST=500m

# -------------------- Timezone & Locale --------------------
# System timezone (IANA timezone name)
TZ=Asia/Kathmandu

# System locale
LANG=en_US.UTF-8

# -------------------- Database (PostgreSQL) --------------------
# PostgreSQL database name
POSTGRES_DB=erpai_platform

# PostgreSQL username
POSTGRES_USER=erpai

# PostgreSQL password
# IMPORTANT: Use a strong, unique password. Never use default in production.
POSTGRES_PASSWORD=erpai_dev_password

# PostgreSQL init database arguments
POSTGRES_INITDB_ARGS="-E UTF8 --locale=en_US.UTF-8"

# -------------------- Database Migration (Flyway) --------------------
# Flyway JDBC URL
FLYWAY_URL=jdbc:postgresql://postgres:5432/

# Flyway username
FLYWAY_USER=erpai

# Flyway password (should match POSTGRES_PASSWORD)
FLYWAY_PASSWORD=erpai_dev_password

# Flyway schemas to manage
FLYWAY_SCHEMAS=public

# Flyway default schema
FLYWAY_DEFAULT_SCHEMA=public

# Flyway create schemas automatically (true/false)
FLYWAY_CREATE_SCHEMAS=true

# Flyway disable clean command (true/false)
FLYWAY_CLEAN_DISABLED=true

# Flyway baseline on migrate (true/false)
FLYWAY_BASELINE_ON_MIGRATE=true

# Flyway baseline version
FLYWAY_BASELINE_VERSION=1

# Flyway validate on migrate (true/false)
FLYWAY_VALIDATE_ON_MIGRATE=true

# Flyway allow out-of-order migrations (true/false)
FLYWAY_OUT_OF_ORDER=false

# Flyway enable placeholder replacement (true/false)
FLYWAY_PLACEHOLDER_REPLACEMENT=true

# Flyway migration locations (comma-separated)
FLYWAY_LOCATIONS=filesystem:infrastructure/postgres/flyway/{service}

# Flyway group pending migrations (true/false)
FLYWAY_GROUP=false

# -------------------- Cache (Redis) --------------------
# Redis password
# IMPORTANT: Use a strong, unique password. Never use default in production.
REDIS_PASSWORD=erpai_dev_password

# -------------------- Message Broker (Kafka) --------------------
# Kafka node ID (must be unique in cluster)
KAFKA_NODE_ID=1

# Kafka controller quorum voters (format: nodeId@host:port)
KAFKA_CONTROLLER_QUORUM_VOTERS=1@kafka:9098

# Kafka listener security protocol map
KAFKA_LISTENER_SECURITY_PROTOCOL_MAP=PLAINTEXT:PLAINTEXT,PLAINTEXT_HOST:PLAINTEXT,CONTROLLER:PLAINTEXT,PLAINTEXT_HOST_ADVERTISED:PLAINTEXT

# Kafka advertised listeners (internal and external)
KAFKA_ADVERTISED_LISTENERS=PLAINTEXT://kafka:9092,PLAINTEXT_HOST://localhost:29092

# Kafka listeners
KAFKA_LISTENERS=PLAINTEXT://0.0.0.0:9092,CONTROLLER://0.0.0.0:9098,PLAINTEXT_HOST://0.0.0.0:29092

# Kafka inter-broker listener name
KAFKA_INTER_BROKER_LISTENER_NAME=PLAINTEXT

# Kafka controller listener names
KAFKA_CONTROLLER_LISTENER_NAMES=CONTROLLER

# Kafka process roles (broker, controller, or both)
KAFKA_PROCESS_ROLES=broker,controller

# Kafka offsets topic replication factor
KAFKA_OFFSETS_TOPIC_REPLICATION_FACTOR=1

# Kafka transaction state log replication factor
KAFKA_TRANSACTION_STATE_LOG_REPLICATION_FACTOR=1

# Kafka transaction state log minimum ISR
KAFKA_TRANSACTION_STATE_LOG_MIN_ISR=1

# Kafka group initial rebalance delay (ms)
KAFKA_GROUP_INITIAL_REBALANCE_DELAY_MS=0

# Kafka default number of partitions
KAFKA_NUM_PARTITIONS=12

# Kafka auto-create topics (true/false)
KAFKA_AUTO_CREATE_TOPICS_ENABLE=true

# Kafka log retention hours
KAFKA_LOG_RETENTION_HOURS=168

# Kafka log segment bytes (1GB default)
KAFKA_LOG_SEGMENT_BYTES=1073741824

# Kafka log retention check interval (ms)
KAFKA_LOG_RETENTION_CHECK_INTERVAL_MS=300000

# Kafka socket send buffer bytes
KAFKA_SOCKET_SEND_BUFFER_BYTES=1048576

# Kafka socket receive buffer bytes
KAFKA_SOCKET_RECEIVE_BUFFER_BYTES=1048576

# Kafka socket request max bytes
KAFKA_SOCKET_REQUEST_MAX_BYTES=104857600

# Kafka bootstrap server (for init scripts)
KAFKA_BOOTSTRAP_SERVER=kafka:9092

# -------------------- Schema Registry --------------------
# Schema registry hostname
SCHEMA_REGISTRY_HOST_NAME=schema-registry

# Schema registry Kafka bootstrap servers
SCHEMA_REGISTRY_KAFKASTORE_BOOTSTRAP_SERVERS=kafka:9092

# Schema registry listeners
SCHEMA_REGISTRY_LISTENERS=http://0.0.0.0:8081

# Schema registry debug mode (true/false)
SCHEMA_REGISTRY_DEBUG=true

# -------------------- Identity Provider (Keycloak) --------------------
# Keycloak admin username
KEYCLOAK_ADMIN=admin

# Keycloak admin password
# IMPORTANT: Use a strong, unique password. Never use default in production.
KEYCLOAK_ADMIN_PASSWORD=admin

# Keycloak database type (dev-mem, postgres, etc.)
KC_DB=dev-mem

# Keycloak HTTP relative path
KC_HTTP_RELATIVE_PATH=/

# Keycloak log level (DEBUG, INFO, WARN, ERROR)
KC_LOG_LEVEL=DEBUG

# Keycloak hostname (for production with TLS)
KC_HOSTNAME=keycloak.localhost

# -------------------- Object Storage (MinIO) --------------------
# MinIO root username
# IMPORTANT: Use a strong, unique username. Never use default in production.
MINIO_ROOT_USER=minioadmin

# MinIO root password
# IMPORTANT: Use a strong, unique password. Never use default in production.
MINIO_ROOT_PASSWORD=minioadmin

# MinIO storage region
MINIO_REGION=us-east-1

# MinIO endpoint (for init scripts)
MINIO_ENDPOINT=http://minio:9000

# -------------------- Monitoring (Prometheus & Grafana) --------------------
# Grafana admin password
# IMPORTANT: Use a strong, unique password. Never use default in production.
GRAFANA_ADMIN_PASSWORD=admin

# Grafana plugins to install (comma-separated, empty for none)
GF_INSTALL_PLUGINS=

# Prometheus retention time (e.g., 30d, 7d)
PROMETHEUS_RETENTION_TIME=30d

# -------------------- Distributed Tracing (Tempo & Jaeger) --------------------
# Jaeger collector zipkin host port
COLLECTOR_ZIPKIN_HOST_PORT=:9411

# Jaeger query base path
QUERY_BASE_PATH=/jaeger

# -------------------- Log Aggregation (Loki) --------------------
# Loki configuration file path (mounted as volume)
LOKI_CONFIG_PATH=./infrastructure/docker/loki/local-config.yaml

# -------------------- Metrics Exporters --------------------
# PostgreSQL exporter data source name
DATA_SOURCE_NAME=postgres://erpai:${POSTGRES_PASSWORD}@postgres:5432/erpai_platform?sslmode=disable

# Redis exporter address
REDIS_ADDR=redis://:${REDIS_PASSWORD}@redis:6379

# -------------------- Email Testing (MailHog) --------------------
# MailHog SMTP port
MAILHOG_SMTP_PORT=1025

# MailHog web UI port
MAILHOG_UI_PORT=8025

# -------------------- Development Tools --------------------
# pgAdmin default email
PGADMIN_EMAIL=admin@erpai.local

# pgAdmin default password
# IMPORTANT: Use a strong, unique password. Never use default in production.
PGADMIN_PASSWORD=admin

# pgAdmin server mode (True for multi-user, False for single-user)
PGADMIN_CONFIG_SERVER_MODE=False

# -------------------- Health Checks --------------------
# Application health check URL
HEALTH_URL=http://localhost:8080/actuator/health/readiness

# Health check timeout in seconds
HEALTH_TIMEOUT=10

# Health check retry count
HEALTH_RETRIES=3

# Health check retry delay in seconds
HEALTH_RETRY_DELAY=2

# -------------------- Actuator & Management --------------------
# Actuator endpoints to expose (comma-separated)
MANAGEMENT_ENDPOINTS_WEB_EXPOSURE_INCLUDE=health,info,metrics,prometheus

# Enable health probes (true/false)
MANAGEMENT_ENDPOINT_HEALTH_PROBES_ENABLED=true

# Enable liveness state (true/false)
MANAGEMENT_HEALTH_LIVENESS_STATE_ENABLED=true

# Enable readiness state (true/false)
MANAGEMENT_HEALTH_READINESS_STATE_ENABLED=true

# -------------------- Logging --------------------
# Log file name/path
LOGGING_FILE_NAME=/app/logs/app.log

# -------------------- Kafka UI --------------------
# Kafka UI cluster name
KAFKA_CLUSTERS_0_NAME=erpai-kafka

# Kafka UI bootstrap servers
KAFKA_CLUSTERS_0_BOOTSTRAPSERVERS=kafka:9092

# Kafka UI schema registry URL
KAFKA_CLUSTERS_0_SCHEMAREGISTRY=http://schema-registry:8081

# Kafka UI security protocol
KAFKA_CLUSTERS_0_KAFKACONFIGS_SECURITY_PROTOCOL=PLAINTEXT

# -------------------- Network --------------------
# Docker network subnet (must match compose files)
DOCKER_NETWORK_SUBNET=172.28.0.0/16

# =============================================================================
# END OF ENVIRONMENT VARIABLES
# =============================================================================
