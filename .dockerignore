# -------------------- Build Artifacts --------------------
# Gradle build outputs
build/
out/
target/
*.jar
*.war
*.ear
*.class

# -------------------- Gradle --------------------
.gradle/
gradle-app.setting
!gradle/wrapper/gradle-wrapper.jar

# -------------------- IDE --------------------
.idea/
*.iml
*.ipr
*.iws
.vscode/
*.swp
*.swo
*~
.project
.classpath
.settings/

# -------------------- OS --------------------
.DS_Store
Thumbs.db
desktop.ini

# -------------------- Environment & Secrets --------------------
.env
.env.local
.env.*.local
*.pem
*.key
*.p12
*.jks
*.p12

# -------------------- Logs --------------------
*.log
logs/
log/

# -------------------- Test Artifacts --------------------
test-results/
coverage/
jacoco.exec
*.exec
build/reports/
build/test-results/

# -------------------- Database --------------------
*.db
*.sql
*.dump
*.h2.db

# -------------------- Temporary Files --------------------
tmp/
temp/
*.tmp
*.temp

# -------------------- Documentation Build --------------------
docs/_build/
docs/.venv/
docs/site/

# -------------------- Frontend --------------------
node_modules/
dist/
.next/
.nuxt/
build/
coverage/

# -------------------- AI Models --------------------
models/
*.onnx
*.pt
*.pkl
*.joblib
*.safetensors

# -------------------- Data Services --------------------
minio-data/
dump.rdb
kafka-logs/
keycloak-data/
zookeeper-data/

# -------------------- Git --------------------
.git/
.gitignore

# -------------------- Documentation (keep README) --------------------
*.md
!README.md
!docs/standards/16-docker-standards.md

# -------------------- Scripts (not needed in image) --------------------
scripts/

# -------------------- Infrastructure (keep Docker scripts) --------------------
# Exclude most infrastructure but keep Docker build scripts
infrastructure/terraform/
infrastructure/k8s/
!infrastructure/docker/
!infrastructure/docker/*.sh
!infrastructure/docker/*.config
!infrastructure/docker/.env.example

# -------------------- CI/CD --------------------
.github/
.gitlab-ci.yml
Jenkinsfile

# -------------------- Docker Files (not needed in image) --------------------
docker-compose.yml
docker-compose*.yml
Dockerfile*
.dockerignore

# -------------------- Misc --------------------
*.pyc
__pycache__/
*.pyo
*.pyd
.Python
.venv/
venv/
ENV/
env/
