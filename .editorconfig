# ERP AI Platform - Editor Configuration
# https://editorconfig.org

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.md]
trim_trailing_whitespace = false

[*.{yml,yaml,json}]
indent_size = 2

[*.{kt,kts}]
indent_size = 4
max_line_length = 120

[*.java]
indent_size = 4
max_line_length = 120

[*.xml]
indent_size = 4

[*.gradle]
indent_size = 4

[*.sql]
indent_size = 4

[*.{js,jsx,ts,tsx}]
indent_size = 2
max_line_length = 100

[*.{py,sh}]
indent_size = 4
