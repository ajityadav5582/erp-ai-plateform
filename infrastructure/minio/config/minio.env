# MinIO Environment Configuration
# Development and Production settings

# -------------------- Server Configuration --------------------
MINIO_ROOT_USER=${MINIO_ROOT_USER:-minioadmin}
MINIO_ROOT_PASSWORD=${MINIO_ROOT_PASSWORD:-minioadmin}
MINIO_REGION=${MINIO_REGION:-us-east-1}
MINIO_BROWSER=${MINIO_BROWSER:-true}

# -------------------- Console Configuration --------------------
MINIO_CONSOLE_ADDRESS=:9001

# -------------------- API Configuration --------------------
MINIO_API_REQUESTS_DEADLINE=10s
MINIO_API_REQUESTS_MAX_DEADLINE=1h

# -------------------- Security --------------------
MINIO_KMS_SECRET_KEY=erpai-minio-kms-key-32-bytes!!
MINIO_CERTS_DIR=/certs

# -------------------- Logging --------------------
MINIO_LOG_LEVEL=INFO
MINIO_LOG_FORMAT=console
MINIO_LOG_DATE_FORMAT=2006-01-02T15:04:05Z07:00

# -------------------- Compression --------------------
MINIO_COMPRESS=true
MINIO_COMPRESS_EXTENSIONS=.gzip,.bz2,.xz,.lzma,.zstd,.lz4
MINIO_COMPRESS_MIME_TYPES=application/gzip,application/x-bzip2,application/x-xz,application/zstd,application/x-lz4

# -------------------- Audit Logging --------------------
MINIO_AUDIT_LOGGER_WEBHOOK_ENDPOINT=
MINIO_AUDIT_LOGGER_WEBHOOK_AUTH_TOKEN=
MINIO_AUDIT_LOGGER_SYSLOG_HOST=
MINIO_AUDIT_LOGGER_SYSLOG_ADDRESS=
