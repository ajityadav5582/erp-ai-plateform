# =============================================================================
# ERP AI Platform - Docker Build Environment Variables
# Copy this file to .env and customize for your environment
# =============================================================================

# -------------------- Application --------------------
APP_NAME=erp-ai-platform
APP_VERSION=0.1.0-SNAPSHOT

# -------------------- Registry --------------------
REGISTRY=registry.example.com
REGISTRY_NAMESPACE=erpai

# -------------------- Build --------------------
BUILD_ARGS=
PUSH=false
CACHE_FROM=
CACHE_TO=
SCAN=false

# -------------------- Service Configuration --------------------
# Example service configuration
# SERVICE_NAME=finance-service
# SERVICE_MODULE=business:finance:interfaces

# -------------------- JVM Configuration --------------------
JAVA_OPTS=
SPRING_PROFILES_ACTIVE=prod
SERVER_PORT=8080

# -------------------- Health Check --------------------
HEALTH_URL=http://localhost:8080/actuator/health/readiness
HEALTH_TIMEOUT=10
HEALTH_RETRIES=3
HEALTH_RETRY_DELAY=2

# -------------------- Resource Limits --------------------
# Default memory limit (used in Kubernetes/Docker Compose)
MEMORY_LIMIT=1G
MEMORY_REQUEST=512M
CPU_LIMIT=1000m
CPU_REQUEST=500m
