# ERP AI Platform - Docker Environment Variables
# Copy this file to .env and update values for your environment

# PostgreSQL
POSTGRES_PASSWORD=erpai_dev_password

# Redis
REDIS_PASSWORD=erpai_dev_password

# Keycloak
KEYCLOAK_ADMIN_PASSWORD=admin

# MinIO
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# Grafana
GRAFANA_ADMIN_PASSWORD=admin

# Application
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/erpai_platform
SPRING_DATASOURCE_USERNAME=erpai
SPRING_DATASOURCE_PASSWORD=erpai_dev_password
SPRING_REDIS_HOST=redis
SPRING_REDIS_PASSWORD=erpai_dev_password
SPRING_KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KEYCLOAK_SERVER_URL=http://keycloak:8080
KEYCLOAK_REALM=erpai
KEYCLOAK_CLIENT_ID=erpai-gateway
KEYCLOAK_CLIENT_SECRET=
MINIO_ENDPOINT=http://minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
