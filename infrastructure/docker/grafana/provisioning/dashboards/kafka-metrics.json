{
  "dashboard": {
    "id": null,
    "title": "Kafka Metrics",
    "tags": ["kafka", "messaging"],
    "timezone": "browser",
    "panels": [
      {
        "id": 1,
        "title": "Messages In/Out per Second",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
        "targets": [
          {
            "expr": "rate(kafka_server_brokertopicmetrics_messagesin_total[5m])",
            "legendFormat": "{{topic}}",
            "refId": "A"
          }
        ]
      },
      {
        "id": 2,
        "title": "Bytes In/Out per Second",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
        "targets": [
          {
            "expr": "rate(kafka_server_brokertopicmetrics_bytesin_total[5m])",
            "legendFormat": "In - {{topic}}",
            "refId": "A"
          },
          {
            "expr": "rate(kafka_server_brokertopicmetrics_bytesout_total[5m])",
            "legendFormat": "Out - {{topic}}",
            "refId": "B"
          }
        ]
      },
      {
        "id": 3,
        "title": "Consumer Lag",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
        "targets": [
          {
            "expr": "kafka_consumergroup_lag",
            "legendFormat": "{{topic}} - {{consumergroup}}",
            "refId": "A"
          }
        ]
      },
      {
        "id": 4,
        "title": "Partition Count",
        "type": "stat",
        "gridPos": {"h": 4, "w": 6, "x": 12, "y": 8},
        "targets": [
          {
            "expr": "count(kafka_topic_partitions)",
            "refId": "A"
          }
        ]
      },
      {
        "id": 5,
        "title": "Active Controller",
        "type": "stat",
        "gridPos": {"h": 4, "w": 6, "x": 18, "y": 8},
        "targets": [
          {
            "expr": "kafka_controller_kafkacontroller_activecontrollercount",
            "refId": "A"
          }
        ]
      }
    ],
    "time": {"from": "now-1h", "to": "now"},
    "refresh": "30s"
  }
}
