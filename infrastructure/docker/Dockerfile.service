# =============================================================================
# ERP AI Platform - Service-Level Dockerfile Template
# For individual microservices (e.g., finance-service, hr-service)
# Copy this file to the service's interfaces/ directory and customize
# Build context: project root (.)
# =============================================================================

# -------------------- Build Arguments --------------------
ARG JAVA_VERSION=21
ARG SERVICE_NAME=service-name
ARG SERVICE_MODULE=service:module:interfaces
ARG APP_VERSION=0.1.0-SNAPSHOT
ARG BUILD_DATE=unknown
ARG VCS_REF=unknown

# -------------------- Build Stage --------------------
FROM eclipse-temurin:21-jdk-jammy AS builder

# Re-declare build args so they are available inside this build stage
# (global ARGs declared before FROM are not automatically in scope per stage).
ARG SERVICE_MODULE

LABEL maintainer="ERP AI Platform Team" \
      org.opencontainers.image.title="${SERVICE_NAME}" \
      org.opencontainers.image.description="ERP AI Platform ${SERVICE_NAME}" \
      org.opencontainers.image.version="${APP_VERSION}" \
      org.opencontainers.image.created="${BUILD_DATE}" \
      org.opencontainers.image.revision="${VCS_REF}"

WORKDIR /app

# Install minimal build dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Copy Gradle wrapper and build files first for optimal layer caching
# NOTE: gradle.properties is intentionally NOT copied: it defines
# org.gradle.java.home pointing at a host-specific macOS JDK that does not
# exist inside this Linux container. Version properties required by build
# scripts (e.g. springCloudVersion) are passed via -P below.
COPY gradle/ gradle/
COPY gradlew build.gradle settings.gradle ./

# Download and cache dependencies
RUN ./gradlew dependencies --no-daemon --stacktrace -PspringCloudVersion=2024.0.1

# Copy source code for this service and shared libraries
COPY platform/ platform/
COPY business/ business/
COPY ai/ ai/
COPY integration/ integration/
COPY libraries/ libraries/

# Build the application JAR (skip tests for Docker build)
# SERVICE_MODULE supports colon-separated paths like:
#   platform:gateway, platform:identity, platform:tenant, business:inventory:application
RUN ./gradlew :${SERVICE_MODULE}:bootJar --no-daemon -x test --stacktrace -PspringCloudVersion=2024.0.1

# Copy the built fat JAR to a fixed location for the runtime stage.
# SERVICE_MODULE is colon-separated (e.g. business:procurement:application);
# convert it to a filesystem path and pick the non-"plain" fat JAR produced by
# bootJar so the runtime stage does not depend on the module path or version.
RUN JAR_DIR=`echo ${SERVICE_MODULE} | tr ':' '/'` && \
    JAR=`ls /app/$JAR_DIR/build/libs/*.jar | grep -v -- '-plain' | head -1` && \
    cp "$JAR" /app/app.jar

# -------------------- Runtime Stage --------------------
FROM eclipse-temurin:21-jre-jammy AS runtime

LABEL maintainer="ERP AI Platform Team" \
      org.opencontainers.image.title="${SERVICE_NAME}" \
      org.opencontainers.image.description="ERP AI Platform ${SERVICE_NAME} Runtime" \
      org.opencontainers.image.version="${APP_VERSION}" \
      org.opencontainers.image.created="${BUILD_DATE}" \
      org.opencontainers.image.revision="${VCS_REF}"

# Create non-root user with fixed UID/GID
RUN groupadd -r -g 1001 appgroup && \
    useradd -r -u 1001 -g appgroup -m -d /home/appuser appuser

WORKDIR /app

# Install wget for health checks
RUN apt-get update && apt-get install -y --no-install-recommends \
    wget \
    && rm -rf /var/lib/apt/lists/*

# Copy JAR from builder with proper ownership
# The JAR location depends on the SERVICE_MODULE path:
#   platform:gateway -> platform/gateway/build/libs/
#   platform:identity -> platform/identity/build/libs/
#   platform:tenant -> platform/tenant/build/libs/
#   business:inventory:application -> business/inventory/application/build/libs/
# The JAR is copied to /app/app.jar by the builder stage above.
COPY --from=builder --chown=appuser:appgroup /app/app.jar app.jar

# Copy health check and entrypoint scripts
COPY --chown=appuser:appgroup infrastructure/docker/healthcheck.sh /app/healthcheck.sh
COPY --chown=appuser:appgroup infrastructure/docker/entrypoint.sh /app/entrypoint.sh

# Create directories for logs and temp
RUN mkdir -p /app/logs /app/tmp && \
    chown -R appuser:appgroup /app/logs /app/tmp && \
    chmod +x /app/healthcheck.sh /app/entrypoint.sh

# Switch to non-root user
USER appuser

# Expose application port
EXPOSE 8080

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD /app/healthcheck.sh || exit 1

# Runtime environment variables
ENV JAVA_OPTS="" \
    SPRING_PROFILES_ACTIVE=prod \
    SERVER_PORT=8080 \
    LOGGING_FILE_NAME=/app/logs/app.log \
    MANAGEMENT_ENDPOINTS_WEB_EXPOSURE_INCLUDE=health,info,metrics,prometheus \
    MANAGEMENT_ENDPOINT_HEALTH_PROBES_ENABLED=true \
    MANAGEMENT_HEALTH_LIVENESS_STATE_ENABLED=true \
    MANAGEMENT_HEALTH_READINESS_STATE_ENABLED=true

# Entrypoint
ENTRYPOINT ["/app/entrypoint.sh"]

# -------------------- Service Target Aliases --------------------
# These stages allow docker-compose to reference services by name:
#   target: gateway   -> builds platform:gateway
#   target: identity  -> builds platform:identity
#   target: tenant    -> builds platform:tenant
#   target: inventory -> builds business:inventory:application
FROM runtime AS gateway
FROM runtime AS identity
FROM runtime AS tenant
FROM runtime AS inventory
