# =============================================================================
# ERP AI Platform - JVM Runtime Configuration
# Container-optimized settings for Java 21 / Spring Boot 3.x
# =============================================================================

# -------------------- Memory Settings --------------------
# Use container memory limits (Java 21+ has this enabled by default)
-XX:+UseContainerSupport
-XX:MaxRAMPercentage=75.0
-XX:InitialRAMPercentage=50.0

# -------------------- Garbage Collection --------------------
# G1GC is the recommended collector for low-latency applications
-XX:+UseG1GC
-XX:MaxGCPauseMillis=200
-XX:+HeapDumpOnOutOfMemoryError
-XX:HeapDumpPath=/app/tmp/heapdump.hprof
-XX:+ExitOnOutOfMemoryError

# String deduplication for reduced memory footprint
-XX:+UseStringDeduplication
-XX:+OptimizeStringConcat

# -------------------- Security --------------------
# Use /dev/urandom for non-blocking entropy
-Djava.security.egd=file:/dev/./urandom

# -------------------- Encoding --------------------
# Ensure consistent UTF-8 encoding
-Dfile.encoding=UTF-8

# -------------------- Spring Boot Actuator --------------------
# Expose health, info, metrics, and Prometheus endpoints
-Dmanagement.endpoints.web.exposure.include=health,info,metrics,prometheus

# Enable Kubernetes-style liveness and readiness probes
-Dmanagement.endpoint.health.probes.enabled=true
-Dmanagement.health.livenessState.enabled=true
-Dmanagement.health.readinessState.enabled=true

# -------------------- Application Settings --------------------
# Default Spring profile (override via environment variable)
-Dspring.profiles.active=prod

# -------------------- Logging --------------------
# Log to file (Docker will also capture stdout/stderr)
-Dlogging.file.name=/app/logs/app.log

# -------------------- Debug (disable in production) --------------------
# Uncomment for debugging (not recommended in production)
#-agentlib:jdwp=transport=dt_socket,server=y,suspend=n,address=*:5005
