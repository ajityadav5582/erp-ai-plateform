# Keycloak PostgreSQL Integration Configuration
# This file contains environment variables for Keycloak with PostgreSQL

# Database Configuration
KC_DB=postgres
KC_DB_URL_HOST=postgres
KC_DB_URL_PORT=5432
KC_DB_URL_DATABASE=erpai_platform
KC_DB_USERNAME=keycloak
KC_DB_PASSWORD=${KEYCLOAK_DB_PASSWORD:-keycloak_dev_password}

# Connection Pool Settings
KC_DB_POOL_INITIAL_SIZE=5
KC_DB_POOL_MIN_SIZE=5
KC_DB_POOL_MAX_SIZE=20

# Keycloak Settings
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=${KEYCLOAK_ADMIN_PASSWORD:-admin}
KC_HTTP_RELATIVE_PATH=/
KC_HOSTNAME=keycloak.localhost

# Development Settings
KC_PROXY=edge
KC_HTTP_ENABLED=true
