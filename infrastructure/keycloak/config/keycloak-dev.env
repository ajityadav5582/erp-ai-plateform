# Keycloak Development Configuration
# Development-specific settings for Keycloak

# Development Mode
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=${KEYCLOAK_ADMIN_PASSWORD:-admin}
KC_DB=dev-mem
KC_HTTP_RELATIVE_PATH=/
KC_LOG_LEVEL=DEBUG

# Development Features
KC_HOSTNAME_DEBUG=true
KC_HEALTH_PROVENANCE_ENABLED=true

# HTTP Configuration
KC_HTTP_ENABLED=true
KC_PROXY=edge

# Theme Configuration
KC_LOGIN_THEME=keycloak
KC_ACCOUNT_THEME=keycloak
KC_ADMIN_THEME=keycloak
KC_EMAIL_THEME=keycloak

# Development Users (placeholders - no business users)
# These are for testing purposes only
# Real users should be created through the application
