package com.erp.platform.shared.email;

import com.erp.platform.common.model.vo.Email;
import jakarta.mail.MessagingException;
import jakarta.mail.internet.MimeMessage;
import org.slf4j.Logger;
import org.slf4j.LoggerFactory;
import org.springframework.beans.factory.annotation.Value;
import org.springframework.mail.javamail.JavaMailSender;
import org.springframework.mail.javamail.MimeMessageHelper;
import org.springframework.stereotype.Service;

/**
 * Email service for sending transactional emails.
 *
 * <p>This service uses Spring's {@link JavaMailSender} to send emails.
 * In development, emails are captured by MailHog and can be viewed at
 * http://localhost:8025.
 *
 * <p>Example usage:
 * <pre>{@code
 * emailService.sendWelcomeEmail(
 *     Email.of("user@example.com"),
 *     "John Doe"
 * );
 * }</pre>
 *
 * @since 1.0.0
 */
@Service
public class EmailService {

    private static final Logger log = LoggerFactory.getLogger(EmailService.class);

    private final JavaMailSender mailSender;

    @Value("${app.email.from:noreply@erpai.local}")
    private String fromEmail;

    @Value("${app.email.from-name:ERP AI Platform}")
    private String fromName;

    @Value("${app.email.reply-to:support@erpai.local}")
    private String replyTo;

    /**
     * Creates a new EmailService.
     *
     * @param mailSender the JavaMailSender to use for sending emails
     */
    public EmailService(JavaMailSender mailSender) {
        this.mailSender = mailSender;
    }

    /**
     * Sends a simple text email.
     *
     * @param to the recipient email address
     * @param subject the email subject
     * @param body the email body (plain text)
     * @throws MessagingException if the email cannot be sent
     */
    public void sendSimpleEmail(Email to, String subject, String body) throws MessagingException {
        log.info("Sending simple email to: {}, subject: {}", to, subject);

        MimeMessage message = mailSender.createMimeMessage();
        MimeMessageHelper helper = new MimeMessageHelper(message, false, "UTF-8");

        helper.setFrom(fromEmail, fromName);
        helper.setTo(to.value());
        helper.setSubject(subject);
        helper.setText(body, false);
        helper.setReplyTo(replyTo);

        mailSender.send(message);
        log.info("Simple email sent successfully to: {}", to);
    }

    /**
     * Sends an HTML email.
     *
     * @param to the recipient email address
     * @param subject the email subject
     * @param htmlContent the email body (HTML)
     * @throws MessagingException if the email cannot be sent
     */
    public void sendHtmlEmail(Email to, String subject, String htmlContent) throws MessagingException {
        log.info("Sending HTML email to: {}, subject: {}", to, subject);

        MimeMessage message = mailSender.createMimeMessage();
        MimeMessageHelper helper = new MimeMessageHelper(message, true, "UTF-8");

        helper.setFrom(fromEmail, fromName);
        helper.setTo(to.value());
        helper.setSubject(subject);
        helper.setText(htmlContent, true);
        helper.setReplyTo(replyTo);

        mailSender.send(message);
        log.info("HTML email sent successfully to: {}", to);
    }

    /**
     * Sends a welcome email to a new user.
     *
     * @param to the recipient email address
     * @param userName the user's full name
     * @throws MessagingException if the email cannot be sent
     */
    public void sendWelcomeEmail(Email to, String userName) throws MessagingException {
        String subject = "Welcome to ERP AI Platform";
        String body = """
            Dear %s,

            Welcome to the ERP AI Platform!

            Your account has been successfully created. You can now log in and start using
            all the features available to you.

            If you have any questions or need assistance, please don't hesitate to contact
            our support team at %s.

            Best regards,
            %s Team
            """.formatted(userName, replyTo, fromName);

        sendSimpleEmail(to, subject, body);
    }

    /**
     * Sends a password reset email.
     *
     * @param to the recipient email address
     * @param resetToken the password reset token
     * @param expiryHours the number of hours until the token expires
     * @throws MessagingException if the email cannot be sent
     */
    public void sendPasswordResetEmail(Email to, String resetToken, int expiryHours) throws MessagingException {
        String subject = "Password Reset Request";
        String resetUrl = "https://erpai.local/auth/reset-password?token=" + resetToken;

        String body = """
            Dear User,

            You have requested to reset your password. Click the link below to proceed:

            %s

            This link will expire in %d hours.

            If you did not request a password reset, please ignore this email or contact
            our support team if you have concerns.

            Best regards,
            %s Team
            """.formatted(resetUrl, expiryHours, fromName);

        sendSimpleEmail(to, subject, body);
    }

    /**
     * Sends an email with multiple recipients (CC and BCC support).
     *
     * @param to the primary recipient email address
     * @param cc the CC recipient email addresses (optional)
     * @param bcc the BCC recipient email addresses (optional)
     * @param subject the email subject
     * @param body the email body (plain text)
     * @throws MessagingException if the email cannot be sent
     */
    public void sendEmailWithRecipients(
            Email to,
            Email[] cc,
            Email[] bcc,
            String subject,
            String body) throws MessagingException {
        log.info("Sending email to: {}, subject: {}", to, subject);

        MimeMessage message = mailSender.createMimeMessage();
        MimeMessageHelper helper = new MimeMessageHelper(message, false, "UTF-8");

        helper.setFrom(fromEmail, fromName);
        helper.setTo(to.value());
        helper.setSubject(subject);
        helper.setText(body, false);
        helper.setReplyTo(replyTo);

        if (cc != null && cc.length > 0) {
            helper.setCc(java.util.Arrays.stream(cc)
                .map(Email::value)
                .toArray(String[]::new));
        }

        if (bcc != null && bcc.length > 0) {
            helper.setBcc(java.util.Arrays.stream(bcc)
                .map(Email::value)
                .toArray(String[]::new));
        }

        mailSender.send(message);
        log.info("Email sent successfully to: {}", to);
    }
}
