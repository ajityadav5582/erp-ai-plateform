# ERP AI Platform - Git Ignore
# Enterprise-grade ignore patterns

# Build outputs
build/
out/
target/
bin/
*.class
*.jar
*.war
*.ear

# Gradle
.gradle/
gradle-app.setting
!gradle/wrapper/gradle-wrapper.jar

# IDE
.idea/
*.iml
*.ipr
*.iws
.vscode/
*.swp
*.swo
*~
.project
.classpath
.settings/

# OS
.DS_Store
Thumbs.db
desktop.ini

# Environment
# NOTE: patterns must NOT be indented, otherwise they are parsed as literal
# filenames and never match. Real secrets live in .env / frontend/.env.
.env
.env.local
.env.*.local
# .env.development is kept as a reference file for local development
# .env.testing, .env.staging, .env.production are environment-specific and should be created as needed
# Templates are committed on purpose:
!.env.example
!frontend/.env.example
!infrastructure/docker/.env.example
# Config samples that intentionally contain non-secret defaults:
!infrastructure/minio/config/minio.env
!infrastructure/keycloak/config/keycloak-dev.env
!infrastructure/keycloak/config/keycloak-postgres.env
*.pem
*.key
*.p12
*.jks

# Logs
*.log
logs/
log/

# Test
test-results/
coverage/
jacoco.exec
*.exec

# Database
*.db
# Dumps / local scratch SQL are ignored, but schema and migration scripts
# are source and MUST be committed. Never blanket-ignore *.sql.
*.dump
*.sql.bak
*.sql.tmp
# Docker entrypoint / seed scripts under infrastructure are source, too.
!infrastructure/**/*.sql
!platform/identity/src/main/resources/db/migration/*.sql

# Docker
docker-compose.override.yml
.docker/

# Kubernetes
k8s/secrets/
k8s/local/

# Temporary
tmp/
temp/
*.tmp

# Documentation build
docs/_build/
docs/.venv/

# Frontend
node_modules/
dist/
.next/
.nuxt/
coverage/
*.tsbuildinfo
next-env.d.ts

# AI Models
models/
*.onnx
*.pt
*.pkl
*.joblib

# MinIO
minio-data/

# Redis
dump.rdb

# Kafka
kafka-logs/

# Keycloak
keycloak-data/
