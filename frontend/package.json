    "next-themes": "^0.4.4",
    "radix-ui": "^1.6.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.81.0",
    "react-redux": "^9.3.0",
    "sonner": "^2.0.7",
