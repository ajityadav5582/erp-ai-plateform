# =============================================================================
# ERP AI Platform - Frontend Environment Variables
# Copy to .env.local for local development: cp .env.example .env.local
# Server-only vars (no NEXT_PUBLIC_ prefix) are NEVER exposed to the browser.
# =============================================================================

# -------------------- Application --------------------
# Public base URL of the application (used for metadata, sitemaps, OG tags)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Deployment environment: development | test | staging | production
NODE_ENV=development

# -------------------- API --------------------
# Base URL of the backend API gateway (server-side only)
API_BASE_URL=http://localhost:8080/api/v1

# Optional API timeout in milliseconds
API_TIMEOUT_MS=30000

# -------------------- Feature Flags --------------------
# Enable verbose client-side logging in non-production
NEXT_PUBLIC_ENABLE_DEBUG_LOGGING=false

# -------------------- Analytics (optional) --------------------
# PostHog / Plausible project key (public, safe to expose)
NEXT_PUBLIC_ANALYTICS_KEY=
